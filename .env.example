# Global
NODE_ENV=development
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=25000
CORS_ORIGIN=http://localhost:5173

# Gateway
API_GATEWAY_PORT=3000
API_GATEWAY_HOST=0.0.0.0
GATEWAY_RATE_LIMIT_MAX=100
GATEWAY_RATE_LIMIT_WINDOW_MS=60000

# Auth (demo profile — replace JWT_SECRET in any shared environment)
JWT_SECRET=local-dev-secret-change-in-prod
JWT_EXPIRY_SECONDS=3600
DEMO_USERNAME=trader
DEMO_PASSWORD=pulsedesk

# Upstream service URLs (local)
ORDER_SERVICE_URL=http://localhost:3012
PORTFOLIO_SERVICE_URL=http://localhost:3015
MARKET_DATA_SERVICE_URL=http://localhost:3011

# Market data service
# Set to a non-empty secret to require X-Api-Key header on POST /ticks
# Leave blank in local dev to keep the endpoint open for testing
INTERNAL_TICK_API_KEY=

# Order service
# Set to a non-empty secret to require X-Api-Key header on order routes
# Leave blank in local dev to keep endpoints open for testing
INTERNAL_ORDER_API_KEY=
RISK_SERVICE_URL=http://localhost:3013
RISK_SERVICE_TIMEOUT_MS=2000

# Set to a non-empty secret to require X-Api-Key header on risk evaluation routes
INTERNAL_RISK_API_KEY=
# Risk policy limits (overrides compile-time defaults)
RISK_MAX_QUANTITY=1000
RISK_MAX_NOTIONAL=100000

# Services
MARKET_DATA_SERVICE_PORT=3011
ORDER_SERVICE_PORT=3012
RISK_SERVICE_PORT=3013
EXECUTION_SERVICE_PORT=3014
PORTFOLIO_SERVICE_PORT=3015
NOTIFICATION_SERVICE_PORT=3016
TRADER_UI_PORT=5173

# Kafka (single-node KRaft for local M1 profile)
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=pulsedesk-local
KAFKA_TOPIC_MARKET_TICKS=market.ticks.v1
KAFKA_TOPIC_ORDER_COMMANDS=orders.commands.v1
KAFKA_TOPIC_ORDER_EVENTS=orders.events.v1
KAFKA_TOPIC_EXECUTION_EVENTS=executions.events.v1
KAFKA_TOPIC_PORTFOLIO_EVENTS=portfolio.events.v1

# PostgreSQL (M1 baseline: single instance, schema-per-service)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pulsedesk
POSTGRES_USER=pulsedesk
POSTGRES_PASSWORD=pulsedesk
DATABASE_URL=postgresql://pulsedesk:pulsedesk@localhost:5432/pulsedesk

# Valkey (Redis-compatible)
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_URL=redis://localhost:6379
# Alias for Redis-compatible clients/libraries
REDIS_URL=redis://localhost:6379

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100
TEMPO_PORT=3200

# ── MFE Frontend (M9) ──────────────────────────────────────────────────────
# These are VITE_ vars — they are baked into the JS bundle at build time.
# In local dev (pnpm dev), each app runs its own Vite dev server on separate ports.
# In Docker Compose, all apps are served by NGINX on port 5173 via sub-paths.

# API and WebSocket endpoints (same for dev and Docker Compose)
VITE_API_BASE_URL=http://localhost:3000
VITE_STREAM_URL=ws://localhost:3016/stream

# Remote base URLs — used by the shell's vite.config.ts federation `remotes` config.
# Dev profile (each remote runs its own Vite dev server):
VITE_TRADING_REMOTE_URL=http://localhost:5174
VITE_PORTFOLIO_REMOTE_URL=http://localhost:5175
VITE_ORDERS_REMOTE_URL=http://localhost:5176
VITE_SIMULATOR_REMOTE_URL=http://localhost:5177
# Docker Compose profile (all served by NGINX on port 5173 at sub-paths):
# VITE_TRADING_REMOTE_URL=http://localhost:5173/trading
# VITE_PORTFOLIO_REMOTE_URL=http://localhost:5173/portfolio
# VITE_ORDERS_REMOTE_URL=http://localhost:5173/orders
# VITE_SIMULATOR_REMOTE_URL=http://localhost:5173/simulator

# Grafana base URL shown in the simulator observability links panel
VITE_GRAFANA_URL=http://localhost:3001

# Gateway rate limit — used by the simulator's client-side rate-limit warning guard
VITE_RATE_LIMIT_PER_MIN=100

# Dev-only auto-login (NEVER set these in production)
# If set, the shell skips the login page and signs in automatically on load.
# Only active when import.meta.env.DEV is true.
VITE_DEMO_USERNAME=trader
VITE_DEMO_PASSWORD=pulsedesk
